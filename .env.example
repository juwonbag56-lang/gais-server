# --- Required ---
# Render Postgres "Internal Database URL"을 그대로 붙여넣으세요.
# 형식: postgres://user:pass@host:port/dbname  또는 postgresql://...
# 서버는 자동으로 +asyncpg 드라이버 prefix로 정규화합니다.
DATABASE_URL=postgres://user:password@host:5432/gais

# --- Optional ---
# 시작 시 alembic upgrade head를 자동 실행할지 여부 (Render에서는 true 권장).
RUN_MIGRATIONS_ON_STARTUP=true

# 데모 사용자 식별자(Flutter 앱이 보내는 user_id 문자열). 변경 시 Flutter 앱과 맞춰야 함.
DEMO_USER_HANDLE=user-1

# Connection Pool 튜닝 (선택)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# Vision (선택, 미사용 시 비워둠)
VISION_API_URL=
VISION_API_KEY=
